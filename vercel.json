{
  "version": 2,
  "redirects": [
    {
      "source": "/knit-price",
      "destination": "/pricing-costing/knit-price",
      "permanent": true
    },
    {
      "source": "/fob-costing",
      "destination": "/pricing-costing/fob-costing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/Marker-Consumption",
      "destination": "/workspace/Marker-Consumption.html"
    },
    {
      "source": "/knit-garments",
      "destination": "/workspace/knit-garments.html"
    },
    {
      "source": "/knit-pant",
      "destination": "/workspace/knit-pant.html"
    },
    {
      "source": "/woven-shirt",
      "destination": "/workspace/woven-shirt.html"
    },
    {
      "source": "/booking-sheet",
      "destination": "/workspace/booking-sheet.html"
    },
    {
      "source": "/pricing-costing",
      "destination": "/workspace/pricing-costing.html"
    },
    {
      "source": "/pricing-costing/knit-price",
      "destination": "/workspace/pricing-costing-knit-price.html"
    },
    {
      "source": "/pricing-costing/fob-costing",
      "destination": "/workspace/pricing-costing-fob-costing.html"
    },
    {
      "source": "/zipper",
      "destination": "/workspace/zipper.html"
    },
    {
      "source": "/trims",
      "destination": "/workspace/trims.html"
    },
    {
      "source": "/size-ratio",
      "destination": "/workspace/size-ratio.html"
    },
    {
      "source": "/converter",
      "destination": "/workspace/converter.html"
    },
    {
      "source": "/my-formulas",
      "destination": "/workspace/my-formulas.html"
    },
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/about",
      "destination": "/information/about.html"
    },
    {
      "source": "/contact",
      "destination": "/information/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/information/privacy-policy.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/information/terms-of-use.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/information/disclaimer.html"
    },
    {
      "source": "/faq",
      "destination": "/pages/help-faq.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
